{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "vite",
		"start:game": "vite build --watch",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"format": "bun run format:code && bun run format:imports",
		"format:code": "biome format --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --linter-enabled=false --write",
		"format-unsafe": "biome check --write --unsafe",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tabler/icons-react": "^3.44.0",
		"@tailwindcss/vite": "^4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.8.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"globals": "^17",
		"typescript": "~6",
		"typescript-eslint": "^8",
		"vite": "^8"
	},
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"."
	]
}
